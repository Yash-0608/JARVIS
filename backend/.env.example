# URL must be reachable from the backend process/container
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Required for desktop API access. Replace with a long random value before LAN use.
JARVIS_API_KEY=replace-with-a-long-random-local-key
ASR_MODEL=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
PAIRING_TTL_SECONDS=180

# Optional official Meta messaging integrations. Keep real tokens only in backend/.env.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v26.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_GRAPH_API_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
