# URL must be reachable from the backend process/container
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Required for desktop API access. Replace with a long random value before LAN use.
JARVIS_API_KEY=replace-with-a-long-random-local-key
ASR_MODEL=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
PAIRING_TTL_SECONDS=180
